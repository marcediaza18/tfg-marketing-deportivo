# Servidor
PORT=4000
NODE_ENV=development

# Base de datos: cadena de conexión de MongoDB Atlas
# Formato: mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/NOMBRE_BD?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/tfg_marketing?retryWrites=true&w=majority

# Seguridad
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS — origen permitido del frontend
CLIENT_ORIGIN=http://localhost:5173
